# ============================================================
# Sistema Leads MVP — variáveis de ambiente (exemplo)
#
# Como usar: copie este arquivo para ".env.local" e preencha.
#   Windows (PowerShell):  Copy-Item .env.example .env.local
#   Mac/Linux:             cp .env.example .env.local
# O arquivo .env.local NUNCA vai para o GitHub.
# ============================================================

# Modo simulação. true = tudo funciona sem nenhuma chave de serviço externo
# (usuários e dados ficam só neste computador). Deixe true até a fase 8.
MOCK_MODE=true

# Segredo usado para assinar o cookie de login. Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# e cole aqui. Em produção é obrigatório e precisa ter 32+ caracteres.
SESSION_SECRET=

# (Opcional) Pasta onde o modo simulação guarda os usuários de teste.
# Se ficar vazio, usa a pasta ".data" dentro do projeto.
# DATA_DIR=

# Busca de empresas (fase 4). Deixe como está para usar empresas de exemplo (simulação).
# Para buscar no OpenStreetMap de verdade (grátis, sem chave, sem cartão): PLACES_PROVIDER=osm
# PLACES_PROVIDER=mock
# Seu e-mail, só para identificar o app para o OpenStreetMap (a política deles pede um contato).
# OSM_CONTACT=
# Máximo de buscas por dia, por pessoa (padrão 20).
# SEARCH_DAILY_LIMIT=20

# ------------------------------------------------------------
# Variáveis das próximas fases (ainda não são usadas na fase 1)
# ------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# GROQ_API_KEY=            # IA do autoresponder (plano gratuito, sem cartão)
# GEMINI_API_KEY=          # alternativa de IA (plano gratuito, sem cartão)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# META_APP_SECRET=
# CRON_SECRET=

# ------------------------------------------------------------
# Banco de dados real (Supabase) — etapa de contas reais
# DATA_BACKEND=file    -> dados em arquivos neste computador (padrão)
# DATA_BACKEND=supabase -> dados e login no Supabase (precisa das 3 chaves abaixo)
# ------------------------------------------------------------
# DATA_BACKEND=file
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública ("Publishable key", começa com sb_publishable_): só confere e-mail e senha no login.
# SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA ("Secret key", começa com sb_secret_): acessa o banco. Nunca mostre a ninguém.
# SUPABASE_SECRET_KEY=

# Respostas automáticas com IA (fase 6). mock = simulação. Depois: groq ou gemini (gratuitos, sem cartão).
# AI_PROVIDER=mock
# GROQ_API_KEY=
# GROQ_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
