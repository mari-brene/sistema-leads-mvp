# ============================================================
# Sistema Leads MVP — variáveis de ambiente (exemplo)
#
# Como usar: copie este arquivo para ".env.local" e preencha.
#   Windows (PowerShell):  Copy-Item .env.example .env.local
#   Mac/Linux:             cp .env.example .env.local
# O arquivo .env.local NUNCA vai para o GitHub.
# Na Vercel, os mesmos nomes vão em Settings > Environment Variables.
#
# Só SESSION_SECRET é obrigatório para rodar no seu computador.
# Todo o resto tem um padrão seguro (simulação, sem chaves).
# ============================================================

# ---------- 1. Básico ----------

# true = tudo funciona em simulação, sem nenhuma chave de serviço externo.
# Em produção com serviços reais, use false.
MOCK_MODE=true

# Segredo que assina o cookie de login. Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Em produção é obrigatório, com 32+ caracteres.
SESSION_SECRET=

# (Opcional) Pasta dos dados locais da simulação. Padrão: ".data" no projeto.
# DATA_DIR=

# ---------- 2. Banco de dados e login (Supabase) ----------

# file     = dados em arquivos neste computador (padrão)
# supabase = dados e login no Supabase (precisa das 3 chaves abaixo)
# DATA_BACKEND=file
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (sb_publishable_...): só confere e-mail e senha no login.
# SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA (sb_secret_...): acessa o banco. Nunca mostre a ninguém.
# SUPABASE_SECRET_KEY=

# Onde ficam os LEADS quando DATA_BACKEND=supabase:
#   collection = dentro da tabela app_data, como sempre (padrão)
#   table      = na tabela própria "leads" (uma linha por lead). Só mude depois de copiar os leads (Parte C2c).
# LEADS_STORE=collection

# Onde ficam as CAMPANHAS (modelos, campanhas, fila e limites) quando DATA_BACKEND=supabase:
#   collection = dentro da tabela app_data (padrão)
#   table      = nas tabelas próprias. Só mude depois de copiar os dados (Parte D3b).
# CAMPAIGNS_STORE=collection

# Onde fica a CAIXA DE ENTRADA (conversas, mensagens, IA) quando DATA_BACKEND=supabase:
#   collection = dentro da tabela app_data (padrão)
#   table      = nas tabelas próprias. Só mude depois de copiar os dados.
# INBOX_STORE=collection

# Onde fica a AUDITORIA quando DATA_BACKEND=supabase:
#   collection = dentro da tabela app_data (padrão)
#   table      = nas tabelas audit_log e audit_state (supabase/06-auditoria.sql). Registros com mais de 90 dias são apagados sozinhos.
# AUDIT_STORE=collection

# Chave que protege o token de WhatsApp de cada cliente guardado no banco (64 caracteres de 0-9 e a-f).
# Gere uma nova com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guarde uma cópia em lugar seguro: sem ela, os números conectados precisam ser conectados de novo. NUNCA mande no chat.
# CREDENTIALS_ENCRYPTION_KEY=

# Cadastro aberto ao público (padrão: true). Com false, só cria conta quem chega por link de convite.
# ALLOW_OPEN_SIGNUP=true

# Onde ficam CLIENTES e VÍNCULOS (quem pertence a qual cliente) quando DATA_BACKEND=supabase:
#   collection = dentro da tabela app_data (padrão)
#   table      = nas tabelas "clients" e "memberships". Rode a migração (cópia) antes de mudar.
# TENANCY_STORE=collection

# ---------- 3. Busca de empresas ----------

# mock = empresas de exemplo (padrão). osm = OpenStreetMap de verdade (grátis, sem chave).
# PLACES_PROVIDER=mock
# Seu e-mail, só para identificar o app ao OpenStreetMap (a política deles pede).
# OSM_CONTACT=
# Máximo de buscas por dia, por pessoa (padrão 20).
# SEARCH_DAILY_LIMIT=20

# ---------- 4. Respostas automáticas com IA ----------

# mock = simulação (padrão). groq ou gemini = planos gratuitos, sem cartão.
# AI_PROVIDER=mock
# GROQ_API_KEY=
# GROQ_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=

# ---------- 5. Agendador de campanhas ----------

# Senha que protege /api/cron/*. Gere como o SESSION_SECRET. 24+ caracteres.
# Use o MESMO valor na Vercel e nos Secrets do GitHub.
# CRON_SECRET=

# ---------- 6. WhatsApp oficial (API da Meta) ----------

# mock = simulação (padrão). cloud = envia de verdade pela API oficial.
# Para enviar de verdade: WHATSAPP_PROVIDER=cloud E MOCK_MODE=false.
# (O botão "Abrir no WhatsApp" manual não precisa de nada disso.)
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Idioma dos modelos aprovados na Meta (o modelo de teste hello_world é en_US)
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# Senha que você inventa (8+ caracteres) e digita também no painel da Meta (webhook)
WHATSAPP_VERIFY_TOKEN=
# App Secret do app na Meta (Configurações do app > Básico)
META_APP_SECRET=
# ID do usuário dono das mensagens recebidas (Supabase > Authentication > Users)
WHATSAPP_OWNER_ID=
